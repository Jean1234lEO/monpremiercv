# ╔══════════════════════════════════════════════════════════════════════╗
# ║  MonPremierCV — Configuration de l'environnement                    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── IA (Gemini) ──────────────────────────────────────────────────────
# Clé API pour les endpoints IA (/api/ai/*)
# Obtenir une clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle Gemini (par défaut : gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── Serveur ──────────────────────────────────────────────────────────
# Port du serveur (Cloud Run / Railway / Render injectent PORT auto.)
PORT=3001

# Port API pour le proxy Vite en développement
API_PORT=3001

# URL publique de l'app déployée (utilisée pour CORS et liens absolus)
APP_URL=http://localhost:3000

# Force le service des fichiers statiques de dist/ même sans NODE_ENV
# SERVE_STATIC=true

# ── Limites de taux ──────────────────────────────────────────────────
# Max d'améliorations IA par IP par heure (défaut : 30)
# AI_RATE_LIMIT_PER_HOUR=30

# ── Dashboard ────────────────────────────────────────────────────────
# Activer/désactiver le dashboard analytics (défaut : true)
# DASHBOARD_ENABLED=true

# Secret pour protéger GET /api/dashboard/stats et /api/dashboard/summary en production.
# Si défini, requiert soit le header `X-Dashboard-Token`, soit `Authorization: Bearer <secret>`, soit `?token=<secret>`.
# DASHBOARD_SECRET=change-moi-par-une-cle-secrete-en-prod
